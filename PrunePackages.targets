<Project>

  <PropertyGroup>
    <PrunePackagesTargetsImported>true</PrunePackagesTargetsImported>
  </PropertyGroup>

  <Import Project="Cpm.props" Condition="'$(CpmPropsImported)' == ''"/>

  <PropertyGroup Condition="'$(CpmId)' != ''">
    <PrunePackagesPath>$(MSBuildThisFileDirectory)PrunePackages.$(CpmId).targets</PrunePackagesPath>
  </PropertyGroup>

  <Import Project="$(PrunePackagesPath)" Condition="'$(CpmId)' != '' And Exists('$(PrunePackagesPath)')" />

</Project>
