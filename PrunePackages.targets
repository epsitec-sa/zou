<Project>

  <PropertyGroup>
    <PrunePackagesTargetsImported>true</PrunePackagesTargetsImported>
  </PropertyGroup>

  <Import Project="Cpm.props" Condition="'$(CpmPropsImported)' == ''"/>

  <PropertyGroup Condition="'$(CpmId)' != ''">
    <PrunePackagesPath Condition="'$(PrunePackagesPath)' == ''">$(MSBuildThisFileDirectory)PrunePackages.$(CpmId).targets</PrunePackagesPath>
  </PropertyGroup>

  <Import Project="$(PrunePackagesPath)" Condition="Exists('$(PrunePackagesPath)') And '$(TargetFrameworkIdentifier)' == '.NETCoreApp'" />

</Project>
