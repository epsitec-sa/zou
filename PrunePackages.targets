<Project>

  <PropertyGroup>
    <!-- Importation semaphore -->
    <PrunePackagesTargetsImported>true</PrunePackagesTargetsImported>
    <PrunePackagesFilename>PrunePackages.$(CpmVerId).targets</PrunePackagesFilename>
  </PropertyGroup>

  <Import Project="$(PrunePackagesFilename)" Condition="Exists('$(PrunePackagesFilename)')" />

</Project>