<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <_BoostVersionToolset Condition="'$(BoostToolset)' != ''">$(BoostToolset)</_BoostVersionToolset>
    <_BoostVersionToolset Condition="'$(_BoostVersionToolset)' == ''">$(PlatformToolset)</_BoostVersionToolset>

    <BoostVersion Condition="'$(BoostVersion)' == '' And ('$(_BoostVersionToolset)' == 'v143' Or '$(_BoostVersionToolset)' == 'vc143')">1.86.0</BoostVersion>
    <BoostVersion Condition="'$(BoostVersion)' == ''">1.91.0</BoostVersion>

    <_PropertySheetDisplayName>[zou] BoostVersion = $(BoostVersion)</_PropertySheetDisplayName>
    <_BoostVersionToolset />
  </PropertyGroup>
</Project>
