<Project  InitialTargets="TraceTargetFrameworkBuildProps">
  
  <PropertyGroup>
    <TargetFrameworkBuildImported>true</TargetFrameworkBuildImported>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworkInp>$(TargetFramework)</TargetFrameworkInp>
    <TargetFrameworksInp>$(TargetFrameworks)</TargetFrameworksInp>

    <BareTargetFrameworkInp>$(BareTargetFramework)</BareTargetFrameworkInp>
    <BareTargetFrameworksInp>$(BareTargetFrameworks)</BareTargetFrameworksInp>
    <MultiTargetingInp>$(MultiTargeting)</MultiTargetingInp>
  </PropertyGroup>

  <PropertyGroup>
    <UseLatestTfm Condition="'$(UseLatestTfm)' == ''">false</UseLatestTfm>

    <!-- BareTargetFrameworks wins over BareTargetFramework; either wins over mode and latest selection. -->
    <_ZouBareTargetFramework Condition="'$(BareTargetFrameworksInp)' == ''">$(BareTargetFramework)</_ZouBareTargetFramework>
    <_ZouBareTargetFrameworks Condition="'$(BareTargetFrameworksInp)' != ''">$(BareTargetFrameworks)</_ZouBareTargetFrameworks>

    <!-- Transform '+' to ';' because semicolons cannot be passed in MSBuild command-line properties. -->
    <BareTargetFrameworksMsBuild Condition="'$(_ZouBareTargetFrameworks)' != ''">$([MSBuild]::Unescape($(_ZouBareTargetFrameworks.Replace('+', ';'))))</BareTargetFrameworksMsBuild>

    <_ZouMultiTargeting Condition="'$(_ZouBareTargetFrameworks)' != ''">true</_ZouMultiTargeting>
    <_ZouMultiTargeting Condition="'$(_ZouMultiTargeting)' == '' And '$(_ZouBareTargetFramework)' != ''">false</_ZouMultiTargeting>
    <_ZouMultiTargeting Condition="'$(_ZouMultiTargeting)' == '' And '$(MultiTargetingInp)' != ''">$(MultiTargetingInp)</_ZouMultiTargeting>
    <_ZouMultiTargeting Condition="'$(_ZouMultiTargeting)' == ''">false</_ZouMultiTargeting>

    <_ZouUseLatestTfm Condition="'$(_ZouBareTargetFramework)' == '' And '$(_ZouBareTargetFrameworks)' == '' And '$(_ZouMultiTargeting)' != 'true' And '$(UseLatestTfm)' == 'true'">true</_ZouUseLatestTfm>
    <_ZouUseLatestTfm Condition="'$(_ZouUseLatestTfm)' == ''">false</_ZouUseLatestTfm>

    <TargetingMode Condition="'$(_ZouBareTargetFrameworks)' != ''">multi</TargetingMode>
    <TargetingMode Condition="'$(TargetingMode)' == '' And '$(_ZouBareTargetFramework)' != ''">single</TargetingMode>
    <TargetingMode Condition="'$(TargetingMode)' == '' And '$(_ZouMultiTargeting)' == 'true'">multi-default</TargetingMode>
    <TargetingMode Condition="'$(TargetingMode)' == '' And '$(_ZouUseLatestTfm)' == 'true'">single-latest</TargetingMode>
    <TargetingMode Condition="'$(TargetingMode)' == ''">single-oldest</TargetingMode>
  </PropertyGroup>

  <PropertyGroup>
    <!-- NU1510 can be triggered by BareTargetFrameworks; it is harmless here. -->
    <NoWarn Condition="'$(_ZouBareTargetFrameworks)' != ''">$(NoWarn);NU1510</NoWarn>

    <!-- Keep the project's original framework pool to resolve bare TFM overrides. -->
    <_ZouProjectTargetFrameworks>$(TargetFrameworks)</_ZouProjectTargetFrameworks>

    <!-- A bare TFM selects the SDK version; its platform suffix is resolved from the project pool. -->
    <_ZouBareTfm Condition="'$(_ZouBareTargetFramework)' != '' And !$(_ZouBareTargetFramework.Contains('-'))">true</_ZouBareTfm>

    <TargetFramework Condition="'$(_ZouBareTargetFramework)' != '' And '$(_ZouBareTfm)' != 'true'">$(_ZouBareTargetFramework)</TargetFramework>
    <TargetFrameworks Condition="'$(_ZouBareTargetFramework)' == '' And '$(_ZouBareTargetFrameworks)' != ''">$(BareTargetFrameworksMsBuild)</TargetFrameworks>
  </PropertyGroup>

  <!-- Narrow the project framework pool to the requested bare TFM and its platform variants.
       Keep the original pool when there is no match, so single-target frameworks remain intact. -->
  <PropertyGroup Condition="'$(_ZouBareTfm)' == 'true' And '$(TargetFrameworks)' != ''">
    <_ZouBareTfmMatch>$([MSBuild]::FilterTargetFrameworks('$(TargetFrameworks)', '$(_ZouBareTargetFramework);$(_ZouBareTargetFramework)-windows;$(_ZouBareTargetFramework)-browser'))</_ZouBareTfmMatch>
    <TargetFrameworks Condition="'$(_ZouBareTfmMatch)' != ''">$(_ZouBareTfmMatch)</TargetFrameworks>
  </PropertyGroup>

  <!-- Resolve each bare multi-target TFM against the project's framework pool. Preserve
       unmatched tokens so validation can report them later. -->
  <PropertyGroup Condition="'$(_ZouBareTargetFramework)' == '' And '$(BareTargetFrameworksMsBuild)' != '' And '$(_ZouProjectTargetFrameworks)' != ''">
    <_ZouMultiRemain>$(BareTargetFrameworksMsBuild)</_ZouMultiRemain>
    <_ZouMultiResolved></_ZouMultiResolved>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_ZouMultiRemain)' != ''">
    <_ZouMultiTok>$([System.Text.RegularExpressions.Regex]::Match('$(_ZouMultiRemain)', '^[^;]+').Value)</_ZouMultiTok>
    <_ZouMultiCandidates Condition="!$(_ZouMultiTok.Contains('-'))">$(_ZouMultiTok);$(_ZouMultiTok)-windows;$(_ZouMultiTok)-browser</_ZouMultiCandidates>
    <_ZouMultiCandidates Condition="$(_ZouMultiTok.Contains('-'))">$(_ZouMultiTok)</_ZouMultiCandidates>
    <_ZouMultiMatch>$([MSBuild]::FilterTargetFrameworks('$(_ZouProjectTargetFrameworks)', '$(_ZouMultiCandidates)'))</_ZouMultiMatch>
    <_ZouMultiResolved Condition="'$(_ZouMultiMatch)' != ''">$(_ZouMultiResolved);$(_ZouMultiMatch)</_ZouMultiResolved>
    <_ZouMultiResolved Condition="'$(_ZouMultiMatch)' == ''">$(_ZouMultiResolved);$(_ZouMultiTok)</_ZouMultiResolved>
    <_ZouMultiRemain>$([System.Text.RegularExpressions.Regex]::Replace('$(_ZouMultiRemain)', '^[^;]+;?', ''))</_ZouMultiRemain>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_ZouMultiRemain)' != ''">
    <_ZouMultiTok>$([System.Text.RegularExpressions.Regex]::Match('$(_ZouMultiRemain)', '^[^;]+').Value)</_ZouMultiTok>
    <_ZouMultiCandidates Condition="!$(_ZouMultiTok.Contains('-'))">$(_ZouMultiTok);$(_ZouMultiTok)-windows;$(_ZouMultiTok)-browser</_ZouMultiCandidates>
    <_ZouMultiCandidates Condition="$(_ZouMultiTok.Contains('-'))">$(_ZouMultiTok)</_ZouMultiCandidates>
    <_ZouMultiMatch>$([MSBuild]::FilterTargetFrameworks('$(_ZouProjectTargetFrameworks)', '$(_ZouMultiCandidates)'))</_ZouMultiMatch>
    <_ZouMultiResolved Condition="'$(_ZouMultiMatch)' != ''">$(_ZouMultiResolved);$(_ZouMultiMatch)</_ZouMultiResolved>
    <_ZouMultiResolved Condition="'$(_ZouMultiMatch)' == ''">$(_ZouMultiResolved);$(_ZouMultiTok)</_ZouMultiResolved>
    <_ZouMultiRemain>$([System.Text.RegularExpressions.Regex]::Replace('$(_ZouMultiRemain)', '^[^;]+;?', ''))</_ZouMultiRemain>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_ZouMultiRemain)' != ''">
    <_ZouMultiTok>$([System.Text.RegularExpressions.Regex]::Match('$(_ZouMultiRemain)', '^[^;]+').Value)</_ZouMultiTok>
    <_ZouMultiCandidates Condition="!$(_ZouMultiTok.Contains('-'))">$(_ZouMultiTok);$(_ZouMultiTok)-windows;$(_ZouMultiTok)-browser</_ZouMultiCandidates>
    <_ZouMultiCandidates Condition="$(_ZouMultiTok.Contains('-'))">$(_ZouMultiTok)</_ZouMultiCandidates>
    <_ZouMultiMatch>$([MSBuild]::FilterTargetFrameworks('$(_ZouProjectTargetFrameworks)', '$(_ZouMultiCandidates)'))</_ZouMultiMatch>
    <_ZouMultiResolved Condition="'$(_ZouMultiMatch)' != ''">$(_ZouMultiResolved);$(_ZouMultiMatch)</_ZouMultiResolved>
    <_ZouMultiResolved Condition="'$(_ZouMultiMatch)' == ''">$(_ZouMultiResolved);$(_ZouMultiTok)</_ZouMultiResolved>
    <_ZouMultiRemain>$([System.Text.RegularExpressions.Regex]::Replace('$(_ZouMultiRemain)', '^[^;]+;?', ''))</_ZouMultiRemain>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_ZouMultiRemain)' != ''">
    <_ZouMultiTok>$([System.Text.RegularExpressions.Regex]::Match('$(_ZouMultiRemain)', '^[^;]+').Value)</_ZouMultiTok>
    <_ZouMultiCandidates Condition="!$(_ZouMultiTok.Contains('-'))">$(_ZouMultiTok);$(_ZouMultiTok)-windows;$(_ZouMultiTok)-browser</_ZouMultiCandidates>
    <_ZouMultiCandidates Condition="$(_ZouMultiTok.Contains('-'))">$(_ZouMultiTok)</_ZouMultiCandidates>
    <_ZouMultiMatch>$([MSBuild]::FilterTargetFrameworks('$(_ZouProjectTargetFrameworks)', '$(_ZouMultiCandidates)'))</_ZouMultiMatch>
    <_ZouMultiResolved Condition="'$(_ZouMultiMatch)' != ''">$(_ZouMultiResolved);$(_ZouMultiMatch)</_ZouMultiResolved>
    <_ZouMultiResolved Condition="'$(_ZouMultiMatch)' == ''">$(_ZouMultiResolved);$(_ZouMultiTok)</_ZouMultiResolved>
    <_ZouMultiRemain>$([System.Text.RegularExpressions.Regex]::Replace('$(_ZouMultiRemain)', '^[^;]+;?', ''))</_ZouMultiRemain>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_ZouMultiRemain)' != ''">
    <_ZouMultiTok>$([System.Text.RegularExpressions.Regex]::Match('$(_ZouMultiRemain)', '^[^;]+').Value)</_ZouMultiTok>
    <_ZouMultiCandidates Condition="!$(_ZouMultiTok.Contains('-'))">$(_ZouMultiTok);$(_ZouMultiTok)-windows;$(_ZouMultiTok)-browser</_ZouMultiCandidates>
    <_ZouMultiCandidates Condition="$(_ZouMultiTok.Contains('-'))">$(_ZouMultiTok)</_ZouMultiCandidates>
    <_ZouMultiMatch>$([MSBuild]::FilterTargetFrameworks('$(_ZouProjectTargetFrameworks)', '$(_ZouMultiCandidates)'))</_ZouMultiMatch>
    <_ZouMultiResolved Condition="'$(_ZouMultiMatch)' != ''">$(_ZouMultiResolved);$(_ZouMultiMatch)</_ZouMultiResolved>
    <_ZouMultiResolved Condition="'$(_ZouMultiMatch)' == ''">$(_ZouMultiResolved);$(_ZouMultiTok)</_ZouMultiResolved>
    <_ZouMultiRemain>$([System.Text.RegularExpressions.Regex]::Replace('$(_ZouMultiRemain)', '^[^;]+;?', ''))</_ZouMultiRemain>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_ZouMultiRemain)' != ''">
    <_ZouMultiTok>$([System.Text.RegularExpressions.Regex]::Match('$(_ZouMultiRemain)', '^[^;]+').Value)</_ZouMultiTok>
    <_ZouMultiCandidates Condition="!$(_ZouMultiTok.Contains('-'))">$(_ZouMultiTok);$(_ZouMultiTok)-windows;$(_ZouMultiTok)-browser</_ZouMultiCandidates>
    <_ZouMultiCandidates Condition="$(_ZouMultiTok.Contains('-'))">$(_ZouMultiTok)</_ZouMultiCandidates>
    <_ZouMultiMatch>$([MSBuild]::FilterTargetFrameworks('$(_ZouProjectTargetFrameworks)', '$(_ZouMultiCandidates)'))</_ZouMultiMatch>
    <_ZouMultiResolved Condition="'$(_ZouMultiMatch)' != ''">$(_ZouMultiResolved);$(_ZouMultiMatch)</_ZouMultiResolved>
    <_ZouMultiResolved Condition="'$(_ZouMultiMatch)' == ''">$(_ZouMultiResolved);$(_ZouMultiTok)</_ZouMultiResolved>
    <_ZouMultiRemain>$([System.Text.RegularExpressions.Regex]::Replace('$(_ZouMultiRemain)', '^[^;]+;?', ''))</_ZouMultiRemain>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_ZouBareTargetFramework)' == '' And '$(BareTargetFrameworksMsBuild)' != '' And '$(_ZouMultiResolved)' != ''">
    <!-- Remove the initial separator and unescape the framework list for the SDK. -->
    <TargetFrameworks>$([MSBuild]::Unescape($([System.Text.RegularExpressions.Regex]::Replace('$(_ZouMultiResolved)', '^;', ''))))</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MultiTargeting)' == '' And '$(_ZouMultiTargeting)' != ''">
    <MultiTargeting>$(_ZouMultiTargeting)</MultiTargeting>
  </PropertyGroup>

  <!-- Set a default TFM for single-target projects. Set TargetFrameworks instead to build
       multiple TFMs; single-target mode selects one matching framework from that list. -->

  <Choose>
    <When Condition="'$(_ZouMultiTargeting)' == 'true'">
      <PropertyGroup>
        <TfmDbgInfo>Multi</TfmDbgInfo>
        <TargetFramework Condition="'$(TargetFrameworks)' != ''" />
        <TargetFrameworks Condition="'$(TargetFrameworks)' == ''">$(CoreTargetFrameworks)</TargetFrameworks>
      </PropertyGroup>
    </When>
    <Otherwise>
      <PropertyGroup>
        <TfmDbgInfo>Single</TfmDbgInfo>
        <TargetFrameworks Condition="'$(TargetFramework)' == '' And '$(TargetFrameworks)' == '' And '$(_ZouUseLatestTfm)' == 'true'">$(CoreTargetFrameworks)</TargetFrameworks>
        <TargetFramework Condition="'$(TargetFramework)' == '' And '$(TargetFrameworks)' == '' And '$(_ZouUseLatestTfm)' != 'true'">$(CoreTargetFramework)</TargetFramework>
      </PropertyGroup>

      <!-- A single candidate needs no matching and may use a nonstandard TFM. -->
      <PropertyGroup Condition="'$(TargetFramework)' == '' And '$(TargetFrameworks)' != '' And !$(TargetFrameworks.Contains(';'))">
        <TfmDbgInfo>$(TfmDbgInfo);0S</TfmDbgInfo>
        <TargetFramework>$(TargetFrameworks)</TargetFramework>
      </PropertyGroup>

      <Choose>
        <!-- Single-targeting: collapse TargetFrameworks down to one TargetFramework -->
        <When Condition="'$(TargetFramework)' == '' And '$(TargetFrameworks)' != ''">
          <PropertyGroup>
            <_ZouCoreMatch   >$([MSBuild]::FilterTargetFrameworks('$(TargetFrameworks)', '$(CoreTargetFrameworks)'))</_ZouCoreMatch>
            <_ZouWindowsMatch>$([MSBuild]::FilterTargetFrameworks('$(TargetFrameworks)', '$(WindowsTargetFrameworks)'))</_ZouWindowsMatch>
            <_ZouBrowserMatch>$([MSBuild]::FilterTargetFrameworks('$(TargetFrameworks)', '$(BrowserTargetFrameworks)'))</_ZouBrowserMatch>
            <_ZouFullMatch   >$([MSBuild]::FilterTargetFrameworks('$(TargetFrameworks)', '$(FullTargetFramework)'))</_ZouFullMatch>
            <_ZouNetStdMatch >$([MSBuild]::FilterTargetFrameworks('$(TargetFrameworks)', '$(NetStdTargetFrameworks)'))</_ZouNetStdMatch>

            <_ZouCoreFirst   >$([System.Text.RegularExpressions.Regex]::Match('$(_ZouCoreMatch)',    '^[^;]+').Value)</_ZouCoreFirst>
            <_ZouWindowsFirst>$([System.Text.RegularExpressions.Regex]::Match('$(_ZouWindowsMatch)', '^[^;]+').Value)</_ZouWindowsFirst>
            <_ZouBrowserFirst>$([System.Text.RegularExpressions.Regex]::Match('$(_ZouBrowserMatch)', '^[^;]+').Value)</_ZouBrowserFirst>
            <_ZouFullFirst   >$([System.Text.RegularExpressions.Regex]::Match('$(_ZouFullMatch)',    '^[^;]+').Value)</_ZouFullFirst>
            <_ZouNetStdFirst >$([System.Text.RegularExpressions.Regex]::Match('$(_ZouNetStdMatch)',  '^[^;]+').Value)</_ZouNetStdFirst>

            <_ZouCoreLast   >$([System.Text.RegularExpressions.Regex]::Match('$(_ZouCoreMatch)',    '[^;]+$').Value)</_ZouCoreLast>
            <_ZouWindowsLast>$([System.Text.RegularExpressions.Regex]::Match('$(_ZouWindowsMatch)', '[^;]+$').Value)</_ZouWindowsLast>
            <_ZouBrowserLast>$([System.Text.RegularExpressions.Regex]::Match('$(_ZouBrowserMatch)', '[^;]+$').Value)</_ZouBrowserLast>
            <_ZouFullLast   >$([System.Text.RegularExpressions.Regex]::Match('$(_ZouFullMatch)',    '[^;]+$').Value)</_ZouFullLast>
            <_ZouNetStdLast >$([System.Text.RegularExpressions.Regex]::Match('$(_ZouNetStdMatch)',  '[^;]+$').Value)</_ZouNetStdLast>

            <_ZouCoreSelected Condition="'$(_ZouUseLatestTfm)' == 'true'">$(_ZouCoreLast)</_ZouCoreSelected>
            <_ZouCoreSelected Condition="'$(_ZouUseLatestTfm)' != 'true'">$(_ZouCoreFirst)</_ZouCoreSelected>
            <_ZouWindowsSelected Condition="'$(_ZouUseLatestTfm)' == 'true'">$(_ZouWindowsLast)</_ZouWindowsSelected>
            <_ZouWindowsSelected Condition="'$(_ZouUseLatestTfm)' != 'true'">$(_ZouWindowsFirst)</_ZouWindowsSelected>
            <_ZouBrowserSelected Condition="'$(_ZouUseLatestTfm)' == 'true'">$(_ZouBrowserLast)</_ZouBrowserSelected>
            <_ZouBrowserSelected Condition="'$(_ZouUseLatestTfm)' != 'true'">$(_ZouBrowserFirst)</_ZouBrowserSelected>
            <_ZouFullSelected Condition="'$(_ZouUseLatestTfm)' == 'true'">$(_ZouFullLast)</_ZouFullSelected>
            <_ZouFullSelected Condition="'$(_ZouUseLatestTfm)' != 'true'">$(_ZouFullFirst)</_ZouFullSelected>
            <_ZouNetStdSelected Condition="'$(_ZouUseLatestTfm)' == 'true'">$(_ZouNetStdLast)</_ZouNetStdSelected>
            <_ZouNetStdSelected Condition="'$(_ZouUseLatestTfm)' != 'true'">$(_ZouNetStdFirst)</_ZouNetStdSelected>

            <TargetFramework Condition="'$(TargetFramework)' == '' And '$(_ZouCoreSelected)' != ''">$(_ZouCoreSelected)</TargetFramework>
            <TargetFramework Condition="'$(TargetFramework)' == '' And '$(_ZouWindowsSelected)' != ''">$(_ZouWindowsSelected)</TargetFramework>
            <TargetFramework Condition="'$(TargetFramework)' == '' And '$(_ZouBrowserSelected)' != ''">$(_ZouBrowserSelected)</TargetFramework>
            <TargetFramework Condition="'$(TargetFramework)' == '' And '$(_ZouFullSelected)' != ''">$(_ZouFullSelected)</TargetFramework>
            <TargetFramework Condition="'$(TargetFramework)' == '' And '$(_ZouNetStdSelected)' != ''">$(_ZouNetStdSelected)</TargetFramework>
          </PropertyGroup>
        </When>

        <When Condition="'$(TargetFramework)' != ''">
          <PropertyGroup>
            <!-- Clear TargetFrameworks to keep the SDK in single-targeting mode. -->
            <TfmDbgInfo>$(TfmDbgInfo);1x</TfmDbgInfo>
            <TargetFrameworks />
          </PropertyGroup>
        </When>
      </Choose>
    </Otherwise>
  </Choose>

  <PropertyGroup Condition="'$(_ZouMultiTargeting)' != 'true' And '$(TargetFramework)' != ''">
    <TargetFrameworks />
  </PropertyGroup>

  <PropertyGroup>
    <BuildType Condition="'$(BuildType)' == '' And '$(TargetFramework)' == '' And '$(TargetFrameworks)' == ''">*Undefined*</BuildType>
    <BuildType Condition="'$(BuildType)' == '' And '$(TargetFramework)' == '' And '$(TargetFrameworks)' != ''">Multi.Outer</BuildType>
    <BuildType Condition="'$(BuildType)' == '' And '$(TargetFramework)' != '' And '$(TargetFrameworks)' != ''">Multi.Inner</BuildType>
    <BuildType Condition="'$(BuildType)' == '' And '$(TargetFramework)' != '' And '$(TargetFrameworks)' == ''">Single</BuildType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' != ''">
    <NetKind Condition="$(TargetFramework.StartsWith('netstandard', StringComparison.OrdinalIgnoreCase))">Standard</NetKind>
    <NetKind Condition="'$(NetKind)' == '' And $([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)', 1)) &lt;= 4.8">Full</NetKind>
    <NetKind Condition="'$(NetKind)' == ''">Core</NetKind>
  </PropertyGroup>

  <!-- Fail when single-target mode cannot resolve any declared framework. -->
  <Target Name="ZouValidateTargetFramework" Condition="'$(_ZouMultiTargeting)' != 'true' And '$(TargetFramework)' == '' And '$(TargetFrameworks)' != ''" BeforeTargets="Build;Restore">
    <Error Text="$([System.String]::Format('$(ErrorInvalidTfmId)', '$(TargetFrameworks)'))" Code="$(ErrorInvalidTfmIdCode)"/>
  </Target>

  <!-- The SDK only declares PickBestRid for inner builds, but SDKs such as Aspire.AppHost.Sdk
       use it during the outer (multi-targeting) Restore. Declare it there too. -->
  <UsingTask TaskName="Microsoft.NET.Build.Tasks.PickBestRid"
             AssemblyFile="$(MicrosoftNETBuildTasksAssembly)"
             Condition="'$(TargetFramework)' == '' And '$(TargetFrameworks)' != '' And '$(MicrosoftNETBuildTasksAssembly)' != ''" />

  <PropertyGroup>
    <TargetFrameworkOut>$(TargetFramework)</TargetFrameworkOut>
    <TargetFrameworksOut>$(TargetFrameworks)</TargetFrameworksOut>
  </PropertyGroup>

  <Import Project="LangVersions.props" Condition="'$(LangVersion)' == ''"/>

  <!-- Warn when the final TFM differs from Zou's resolution, usually due to a project-level
       override. Put intentional defaults in zou.build.tfm.props; allow known overrides with
       ZouAllowLegacyTfmOverride=true. -->
  <Target Name="ZouWarnTfmOverride"
          Condition="'$(TargetFramework)' != '' And '$(TargetFramework)' != '$(TargetFrameworkOut)' And '$(ZouAllowLegacyTfmOverride)' != 'true'"
          BeforeTargets="Build;Restore">
    <Warning Text="'$(MSBuildProjectFile)': $([System.String]::Format('$(WarnTfmOverrideId)', '$(TargetFramework)', '$(TargetFrameworkOut)'))" Code="$(WarnTfmOverrideIdCode)" />
  </Target>

  <Target Name="TraceTargetFrameworkBuildProps" Condition="'$(TfmDebug)' == 'true'" BeforeTargets="ZouValidateTargetFramework;ZouWarnTfmOverride">
    <Message Importance="high" Text="$(NC) " />
    <Message Importance="high" Text="$(T0)$([MSBuild]::MakeRelative('$(BundleDir)', '$(MSBuildThisFileFullPath)')) ($(BundleRelativeProjectPath))$(NC)" />

    <PropertyGroup>
      <TfmMultiColor Condition="'$(BuildType)'        == 'Multi.Outer'">$(Brown)</TfmMultiColor>
      <TfmMultiColor Condition="'$(TfmMultiColor)'    == ''">$(NC)</TfmMultiColor>

      <TfmEndColor   Condition="'$(TargetFramework)'  != '$(TargetFrameworkOut)'" >$(Brown)</TfmEndColor>
      <TfmsEndColor  Condition="'$(TargetFrameworks)' != '$(TargetFrameworksOut)'">$(Brown)</TfmsEndColor>
      <TfmColor      Condition="'$(TargetFramework)'  != '$(TargetFrameworkOut)'" >$(Yellow)</TfmColor>
      <TfmsColor     Condition="'$(TargetFrameworks)' != '$(TargetFrameworksOut)'">$(Yellow)</TfmsColor>

      <TfmEndColor   Condition="'$(TfmEndColor)'      == ''">$(Green)</TfmEndColor>
      <TfmsEndColor  Condition="'$(TfmsEndColor)'     == ''">$(Green)</TfmsEndColor>
      <TfmColor      Condition="'$(TfmColor)'         == ''">$(LightGreen)</TfmColor>
      <TfmsColor     Condition="'$(TfmsColor)'        == ''">$(LightGreen)</TfmsColor>
    </PropertyGroup>

    <Message Importance="high" Text="$(TfmMultiColor)MaxCpuCount             = $(Purple)$(MaxCpuCount)$(NC)"                 Condition="'$(MaxCpuCount)'  != ''" />
    <Message Importance="high" Text="$(TfmMultiColor)ZouAgentType            = $(Purple)$(ZouAgentType)$(NC)"                Condition="'$(ZouAgentType)' != ''" />
    <Message Importance="high" Text="$(TfmMultiColor)TfmDbgInfo              = $(Purple)$(TfmDbgInfo)$(NC)"                  Condition="'$(TfmDbgInfo)'   != ''" />
    <Message Importance="high" Text="$(TfmMultiColor)MultiTargeting          = $(Yellow)$(_ZouMultiTargeting)$(NC)" />
    <Message Importance="high" Text="$(TfmMultiColor)UseLatestTfm            = $(Yellow)$(_ZouUseLatestTfm)$(NC)" />
    <Message Importance="high" Text="$(TfmMultiColor)BuildType               = $(BuildType)$(NC)" />
    <Message Importance="high" Text="$(TfmMultiColor)NetKind                 = $(NetKind)$(NC)"                              Condition="'$(TargetFramework)' != ''" />

    <Message Importance="high" Text="$(TfmMultiColor)BareTargetFrameworksInp = $(Yellow){$(BareTargetFrameworksInp)}$(NC)"   Condition="'$(BareTargetFrameworksInp)' != ''" />
    <Message Importance="high" Text="$(TfmMultiColor)BareTargetFrameworks    = $(Yellow){$(BareTargetFrameworks)}$(NC)"      Condition="'$(BareTargetFrameworks)'    != ''" />
    <Message Importance="high" Text="$(TfmMultiColor)TargetFrameworksInp     = $(LightBlue){$(TargetFrameworksInp)}$(NC)"    Condition="'$(TargetFrameworksInp)'     != '' And '$(TargetFrameworksInp)'    != '$(BareTargetFrameworksInp)'" />
    <Message Importance="high" Text="$(TfmMultiColor)TargetFrameworks_01     = $(LightBlue){$(TargetFrameworks_01)}$(NC)"    Condition="'$(TargetFrameworks_01)'     != '' And '$(TargetFrameworks_01)'    != '$(TargetFrameworksInp)'" />
    <Message Importance="high" Text="$(TfmMultiColor)TargetFrameworks_02     = $(LightBlue){$(TargetFrameworks_02)}$(NC)"    Condition="'$(TargetFrameworks_02)'     != '' And '$(TargetFrameworks_02)'    != '$(TargetFrameworks_01)'" />
    <Message Importance="high" Text="$(TfmMultiColor)TargetFrameworksOut     = $(TfmsEndColor){$(TargetFrameworksOut)}$(NC)" Condition="'$(TargetFrameworksOut)'     != '$(TargetFrameworksInp)'" />

    <Message Importance="high" Text="$(TfmMultiColor)BareTargetFramework     = $(Yellow)$(BareTargetFramework)$(NC)"         Condition="'$(BareTargetFramework)'    != ''" />
    <Message Importance="high" Text="$(TfmMultiColor)BareTargetFrameworkInp  = $(Yellow)$(BareTargetFrameworkInp)$(NC)"      Condition="'$(BareTargetFrameworkInp)' != ''" />
    <Message Importance="high" Text="$(TfmMultiColor)TargetFrameworkInp      = $(LightBlue)$(TargetFrameworkInp)$(NC)"       Condition="'$(TargetFrameworkInp)'     != ''" />
    <Message Importance="high" Text="$(TfmMultiColor)TargetFramework_01      = $(LightBlue)$(TargetFramework_01)$(NC)"       Condition="'$(TargetFramework_01)'     != '' And '$(TargetFramework_01)'    != '$(TargetFrameworkInp)'" />
    <Message Importance="high" Text="$(TfmMultiColor)TargetFramework_02      = $(LightBlue)$(TargetFramework_02)$(NC)"       Condition="'$(TargetFramework_02)'     != '' And '$(TargetFramework_02)'    != '$(TargetFrameworkOut)'" />
    <Message Importance="high" Text="$(TfmMultiColor)TargetFrameworkOut      = $(TfmEndColor)$(TargetFrameworkOut)$(NC)"     Condition="'$(TargetFrameworkOut)'     != '' And '$(TargetFrameworkOut)'    != '$(TargetFrameworkInp)'" />

    <Message Importance="high" Text="$(TfmMultiColor)LangVersion             = $(Green)C#$(LangVersion)$(NC)"                Condition="'$(BuildType)'          != 'Multi.Outer'" />
    <Message Importance="high" Text="$(TfmMultiColor)TargetFrameworks        = $(TfmsColor){$(TargetFrameworks)}$(NC)"       Condition="'$(TargetFrameworks)'   != ''" />
    <Message Importance="high" Text="$(TfmMultiColor)TargetFramework         = $(TfmColor)$(TargetFramework)$(NC)"           Condition="'$(TargetFramework)'    != ''" />
    <Message Importance="high" Text="$(TfmMultiColor)TargetingMode           = $(Brown)$(TargetingMode)$(NC)" />
  </Target>

</Project>
