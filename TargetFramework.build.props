<Project  InitialTargets="TraceTargetFrameworkBuildProps">
  
  <PropertyGroup>
    <TargetFrameworkInp>$(TargetFramework)</TargetFrameworkInp>
    <TargetFrameworksInp>$(TargetFrameworks)</TargetFrameworksInp>
    <ZouTargetFrameworkInp>$(ZouTargetFramework)</ZouTargetFrameworkInp>
    <ZouTargetFrameworksInp>$(ZouTargetFrameworks)</ZouTargetFrameworksInp>
    <MultiTargetingInp>$(MultiTargeting)</MultiTargetingInp>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworkBuildImported>true</TargetFrameworkBuildImported>
  </PropertyGroup>

  <PropertyGroup>
    <ZouTargetFrameworks Condition="'$(ZouTargetFramework)' != ''" />
    <!-- Transform 'net8.0+net10.0' to 'net8.0;net10.0' due to MSBuild CLI syntax
         rejecting ';' and ',' in -p: values; Unescape() undoes the internal escaping
         MSBuild applies to the ';' introduced by Replace() before it gets split. -->
    <ZouTargetFrameworksMsBuild Condition="'$(ZouTargetFrameworks)' != ''">$([MSBuild]::Unescape($(ZouTargetFrameworks.Replace('+', ';'))))</ZouTargetFrameworksMsBuild>

    <!-- Snapshot of the project's own TargetFrameworks pool (set by its zou.build.tfm.props,
         e.g. net8.0-windows;net10.0-windows for a WinForms project), captured before any Zou
         CLI override below replaces TargetFrameworks. Used to resolve bare TFM tokens (no
         platform suffix) to their platform-qualified form, both for the single-targeting
         (_ZouBareTfm) and the multi-targeting (ZouTargetFrameworks) case further down. -->
    <_ZouProjectTargetFrameworks>$(TargetFrameworks)</_ZouProjectTargetFrameworks>

    <!--
      ZouTargetFramework without a platform suffix (e.g. "net8.0", no "-windows"/"-browser"/...)
      is treated as a bare SDK version selector rather than a literal TargetFramework value.
      This lets the same "-p:ZouTargetFramework=net8.0" work uniformly across a plain project
      (TargetFrameworks=net8.0;net10.0;...), a WinForms project (TargetFrameworks=net8.0-windows;
      net10.0-windows), a Browser/WASM project, etc. — the actual platform-qualified TFM is
      resolved below, from whatever TargetFrameworks the project's own zou.build.tfm.props already
      declared, using the same Core/Windows/Browser/Full/NetStd matching logic as the
      single-targeting collapse further down.
      With an explicit suffix (e.g. "net8.0-windows"), behavior is unchanged: direct override.
    -->
    <_ZouBareTfm Condition="'$(ZouTargetFramework)' != '' And !$(ZouTargetFramework.Contains('-'))">true</_ZouBareTfm>

    <TargetFramework  Condition="'$(ZouTargetFramework)' != '' And '$(_ZouBareTfm)' != 'true'">$(ZouTargetFramework)</TargetFramework>
    <TargetFrameworks Condition="'$(ZouTargetFramework)' == '' And '$(ZouTargetFrameworks)' != ''">$(ZouTargetFrameworksMsBuild)</TargetFrameworks>
  </PropertyGroup>

  <!--
    Bare ZouTargetFramework: narrow TargetFrameworks (already resolved by the project's own
    zou.build.tfm.props, e.g. to net8.0-windows;net10.0-windows) down to the entries matching
    this SDK version, across any platform suffix. The Choose/Otherwise below then picks the
    right candidate (Core/Windows/Browser/Full/NetStd) exactly as it would without this
    override.
  -->
  <PropertyGroup Condition="'$(_ZouBareTfm)' == 'true' And '$(TargetFrameworks)' != ''">
    <TargetFrameworks>$([MSBuild]::FilterTargetFrameworks('$(TargetFrameworks)', '$(ZouTargetFramework);$(ZouTargetFramework)-windows;$(ZouTargetFramework)-browser'))</TargetFrameworks>
  </PropertyGroup>

  <!--
    Multi-targeting case: ZouTargetFrameworks may also contain bare TFM tokens, exactly like
    the single-targeting _ZouBareTfm case above (e.g. "net8.0+net10.0" on a WinForms project
    should resolve to "net8.0-windows;net10.0-windows"). Each token is peeled off one at a time
    via regex (rather than a Split()[i] indexer, to match this file's existing style and stay
    usable on older MSBuild toolsets) and resolved against the project's own TargetFrameworks
    pool (_ZouProjectTargetFrameworks): bare tokens are expanded to "<tfm>;<tfm>-windows;
    <tfm>-browser" and matched against the pool; tokens that already carry a platform suffix
    pass through unchanged. A token with no match in the pool is kept as-is, so
    ZouValidateTargetFramework/the SDK can still report a clear error on it downstream instead
    of it silently vanishing.
  -->
  <PropertyGroup Condition="'$(ZouTargetFramework)' == '' And '$(ZouTargetFrameworksMsBuild)' != '' And '$(_ZouProjectTargetFrameworks)' != ''">
    <_ZouMultiRemain>$(ZouTargetFrameworksMsBuild)</_ZouMultiRemain>
    <_ZouMultiResolved></_ZouMultiResolved>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_ZouMultiRemain)' != ''">
    <_ZouMultiTok>$([System.Text.RegularExpressions.Regex]::Match('$(_ZouMultiRemain)', '^[^;]+').Value)</_ZouMultiTok>
    <_ZouMultiCandidates Condition="!$(_ZouMultiTok.Contains('-'))">$(_ZouMultiTok);$(_ZouMultiTok)-windows;$(_ZouMultiTok)-browser</_ZouMultiCandidates>
    <_ZouMultiCandidates Condition="$(_ZouMultiTok.Contains('-'))">$(_ZouMultiTok)</_ZouMultiCandidates>
    <_ZouMultiMatch>$([MSBuild]::FilterTargetFrameworks('$(_ZouProjectTargetFrameworks)', '$(_ZouMultiCandidates)'))</_ZouMultiMatch>
    <_ZouMultiResolved Condition="'$(_ZouMultiMatch)' != ''">$(_ZouMultiResolved);$(_ZouMultiMatch)</_ZouMultiResolved>
    <_ZouMultiResolved Condition="'$(_ZouMultiMatch)' == ''">$(_ZouMultiResolved);$(_ZouMultiTok)</_ZouMultiResolved>
    <_ZouMultiRemain>$([System.Text.RegularExpressions.Regex]::Replace('$(_ZouMultiRemain)', '^[^;]+;?', ''))</_ZouMultiRemain>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_ZouMultiRemain)' != ''">
    <_ZouMultiTok>$([System.Text.RegularExpressions.Regex]::Match('$(_ZouMultiRemain)', '^[^;]+').Value)</_ZouMultiTok>
    <_ZouMultiCandidates Condition="!$(_ZouMultiTok.Contains('-'))">$(_ZouMultiTok);$(_ZouMultiTok)-windows;$(_ZouMultiTok)-browser</_ZouMultiCandidates>
    <_ZouMultiCandidates Condition="$(_ZouMultiTok.Contains('-'))">$(_ZouMultiTok)</_ZouMultiCandidates>
    <_ZouMultiMatch>$([MSBuild]::FilterTargetFrameworks('$(_ZouProjectTargetFrameworks)', '$(_ZouMultiCandidates)'))</_ZouMultiMatch>
    <_ZouMultiResolved Condition="'$(_ZouMultiMatch)' != ''">$(_ZouMultiResolved);$(_ZouMultiMatch)</_ZouMultiResolved>
    <_ZouMultiResolved Condition="'$(_ZouMultiMatch)' == ''">$(_ZouMultiResolved);$(_ZouMultiTok)</_ZouMultiResolved>
    <_ZouMultiRemain>$([System.Text.RegularExpressions.Regex]::Replace('$(_ZouMultiRemain)', '^[^;]+;?', ''))</_ZouMultiRemain>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_ZouMultiRemain)' != ''">
    <_ZouMultiTok>$([System.Text.RegularExpressions.Regex]::Match('$(_ZouMultiRemain)', '^[^;]+').Value)</_ZouMultiTok>
    <_ZouMultiCandidates Condition="!$(_ZouMultiTok.Contains('-'))">$(_ZouMultiTok);$(_ZouMultiTok)-windows;$(_ZouMultiTok)-browser</_ZouMultiCandidates>
    <_ZouMultiCandidates Condition="$(_ZouMultiTok.Contains('-'))">$(_ZouMultiTok)</_ZouMultiCandidates>
    <_ZouMultiMatch>$([MSBuild]::FilterTargetFrameworks('$(_ZouProjectTargetFrameworks)', '$(_ZouMultiCandidates)'))</_ZouMultiMatch>
    <_ZouMultiResolved Condition="'$(_ZouMultiMatch)' != ''">$(_ZouMultiResolved);$(_ZouMultiMatch)</_ZouMultiResolved>
    <_ZouMultiResolved Condition="'$(_ZouMultiMatch)' == ''">$(_ZouMultiResolved);$(_ZouMultiTok)</_ZouMultiResolved>
    <_ZouMultiRemain>$([System.Text.RegularExpressions.Regex]::Replace('$(_ZouMultiRemain)', '^[^;]+;?', ''))</_ZouMultiRemain>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_ZouMultiRemain)' != ''">
    <_ZouMultiTok>$([System.Text.RegularExpressions.Regex]::Match('$(_ZouMultiRemain)', '^[^;]+').Value)</_ZouMultiTok>
    <_ZouMultiCandidates Condition="!$(_ZouMultiTok.Contains('-'))">$(_ZouMultiTok);$(_ZouMultiTok)-windows;$(_ZouMultiTok)-browser</_ZouMultiCandidates>
    <_ZouMultiCandidates Condition="$(_ZouMultiTok.Contains('-'))">$(_ZouMultiTok)</_ZouMultiCandidates>
    <_ZouMultiMatch>$([MSBuild]::FilterTargetFrameworks('$(_ZouProjectTargetFrameworks)', '$(_ZouMultiCandidates)'))</_ZouMultiMatch>
    <_ZouMultiResolved Condition="'$(_ZouMultiMatch)' != ''">$(_ZouMultiResolved);$(_ZouMultiMatch)</_ZouMultiResolved>
    <_ZouMultiResolved Condition="'$(_ZouMultiMatch)' == ''">$(_ZouMultiResolved);$(_ZouMultiTok)</_ZouMultiResolved>
    <_ZouMultiRemain>$([System.Text.RegularExpressions.Regex]::Replace('$(_ZouMultiRemain)', '^[^;]+;?', ''))</_ZouMultiRemain>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_ZouMultiRemain)' != ''">
    <_ZouMultiTok>$([System.Text.RegularExpressions.Regex]::Match('$(_ZouMultiRemain)', '^[^;]+').Value)</_ZouMultiTok>
    <_ZouMultiCandidates Condition="!$(_ZouMultiTok.Contains('-'))">$(_ZouMultiTok);$(_ZouMultiTok)-windows;$(_ZouMultiTok)-browser</_ZouMultiCandidates>
    <_ZouMultiCandidates Condition="$(_ZouMultiTok.Contains('-'))">$(_ZouMultiTok)</_ZouMultiCandidates>
    <_ZouMultiMatch>$([MSBuild]::FilterTargetFrameworks('$(_ZouProjectTargetFrameworks)', '$(_ZouMultiCandidates)'))</_ZouMultiMatch>
    <_ZouMultiResolved Condition="'$(_ZouMultiMatch)' != ''">$(_ZouMultiResolved);$(_ZouMultiMatch)</_ZouMultiResolved>
    <_ZouMultiResolved Condition="'$(_ZouMultiMatch)' == ''">$(_ZouMultiResolved);$(_ZouMultiTok)</_ZouMultiResolved>
    <_ZouMultiRemain>$([System.Text.RegularExpressions.Regex]::Replace('$(_ZouMultiRemain)', '^[^;]+;?', ''))</_ZouMultiRemain>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_ZouMultiRemain)' != ''">
    <_ZouMultiTok>$([System.Text.RegularExpressions.Regex]::Match('$(_ZouMultiRemain)', '^[^;]+').Value)</_ZouMultiTok>
    <_ZouMultiCandidates Condition="!$(_ZouMultiTok.Contains('-'))">$(_ZouMultiTok);$(_ZouMultiTok)-windows;$(_ZouMultiTok)-browser</_ZouMultiCandidates>
    <_ZouMultiCandidates Condition="$(_ZouMultiTok.Contains('-'))">$(_ZouMultiTok)</_ZouMultiCandidates>
    <_ZouMultiMatch>$([MSBuild]::FilterTargetFrameworks('$(_ZouProjectTargetFrameworks)', '$(_ZouMultiCandidates)'))</_ZouMultiMatch>
    <_ZouMultiResolved Condition="'$(_ZouMultiMatch)' != ''">$(_ZouMultiResolved);$(_ZouMultiMatch)</_ZouMultiResolved>
    <_ZouMultiResolved Condition="'$(_ZouMultiMatch)' == ''">$(_ZouMultiResolved);$(_ZouMultiTok)</_ZouMultiResolved>
    <_ZouMultiRemain>$([System.Text.RegularExpressions.Regex]::Replace('$(_ZouMultiRemain)', '^[^;]+;?', ''))</_ZouMultiRemain>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ZouTargetFramework)' == '' And '$(ZouTargetFrameworksMsBuild)' != '' And '$(_ZouMultiResolved)' != ''">
    <!-- Strip the leading ';' left by the first append, then Unescape() — same reasoning as
         ZouTargetFrameworksMsBuild above: the ';' characters accumulated through string
         concatenation across the peeling loop can end up internally escaped, which the .NET
         SDK's own outer/inner multi-targeting split then fails to parse as a real list
         (NETSDK1046: "TargetFramework value '...' is not valid"). -->
    <TargetFrameworks>$([MSBuild]::Unescape($([System.Text.RegularExpressions.Regex]::Replace('$(_ZouMultiResolved)', '^;', ''))))</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup>
    <!--
    Determine if the project is multi-targeting
    If ZouTargetFrameworks is set, then it is multi-targeting
    If ZouTargetFramework is set, then it is single-targeting
    Default to single-targeting
    -->
    <MultiTargeting Condition="'$(ZouTargetFrameworks)' != ''">true</MultiTargeting>
    <MultiTargeting Condition="'$(ZouTargetFramework)'  != ''">false</MultiTargeting>
    <MultiTargeting Condition="'$(MultiTargeting)'      == ''">false</MultiTargeting>
  </PropertyGroup>

  <!--
    This is the default for C# projects that do not define the TargetFramework property.
    You can override this in a Directory.Build.props file (before this import)
    or in your project file (after this import).

    Single-targeting projects may instead opt into one of these fixed values:
      TargetFramework=$(FullTargetFramework)     e.g. net48
      TargetFramework=$(WindowsTargetFramework)  e.g. net8.0-windows / net10.0-windows
      TargetFramework=$(WineTargetFramework)     e.g. netcoreapp3.1 (for projects running inside a Wine bottle on Mac)

    If you want to build for multiple frameworks, set the TargetFrameworks
    property instead of TargetFramework in a Directory.Build.props file (before this import)
    or in your project file (after this import), typically as one of:
      TargetFrameworks=$(CoreTargetFrameworks)
      TargetFrameworks=netstandard2.0;$(CoreTargetFrameworks)

    In that case, when MultiTargeting is true, TargetFramework is left unset and the
    project builds for all frameworks listed in TargetFrameworks.
    When MultiTargeting is false (default), TargetFrameworks is collapsed down to a
    single TargetFramework matching CoreTargetFramework/WindowsTargetFramework, so that
    build machines only need the SDK for that one framework installed.
  -->

  <Choose>
    <When Condition="'$(MultiTargeting)' == 'true'">
      <PropertyGroup>
        <TfmDbgInfo>Multi</TfmDbgInfo>
        <TargetFramework Condition="'$(TargetFrameworks)' != ''" />
      </PropertyGroup>
    </When>
    <Otherwise>
      <PropertyGroup>
        <TfmDbgInfo>Single</TfmDbgInfo>
      </PropertyGroup>
      <!-- Single-targeting: collapse TargetFrameworks down to one TargetFramework -->
      <PropertyGroup Condition="'$(TargetFramework)' == '' And '$(TargetFrameworks)' != ''">
        <TfmDbgInfo>$(TfmDbgInfo);01</TfmDbgInfo>
        <TargetFramework_01>$(TargetFramework)</TargetFramework_01>
        <TargetFrameworks_01>$(TargetFrameworks)</TargetFrameworks_01>

        <_ZouCoreMatch   >$([MSBuild]::FilterTargetFrameworks('$(TargetFrameworks)', '$(CoreTargetFrameworks)'))</_ZouCoreMatch>
        <_ZouWindowsMatch>$([MSBuild]::FilterTargetFrameworks('$(TargetFrameworks)', '$(WindowsTargetFrameworks)'))</_ZouWindowsMatch>
        <_ZouBrowserMatch>$([MSBuild]::FilterTargetFrameworks('$(TargetFrameworks)', '$(BrowserTargetFrameworks)'))</_ZouBrowserMatch>
        <!-- Restored: this candidate was dropped when the original string-Contains matching
             was refactored to FilterTargetFrameworks, silently breaking single-targeting
             collapse for net4.8 (only reachable, until now, via a bare ZouTargetFramework or
             a TargetFrameworks list that happens to include net4.8 without net8.0/net10.0/
             netstandard also matching first). FullTargetFramework has no plural counterpart
             (only one .NET Framework version is ever expected), so the filter list is just
             the single value. -->
        <_ZouFullMatch   >$([MSBuild]::FilterTargetFrameworks('$(TargetFrameworks)', '$(FullTargetFramework)'))</_ZouFullMatch>
        <_ZouNetStdMatch >$([MSBuild]::FilterTargetFrameworks('$(TargetFrameworks)', '$(NetStdTargetFrameworks)'))</_ZouNetStdMatch>

        <_ZouCoreFirst   >$([System.Text.RegularExpressions.Regex]::Match('$(_ZouCoreMatch)',    '^[^;]+').Value)</_ZouCoreFirst>
        <_ZouWindowsFirst>$([System.Text.RegularExpressions.Regex]::Match('$(_ZouWindowsMatch)', '^[^;]+').Value)</_ZouWindowsFirst>
        <_ZouBrowserFirst>$([System.Text.RegularExpressions.Regex]::Match('$(_ZouBrowserMatch)', '^[^;]+').Value)</_ZouBrowserFirst>
        <_ZouFullFirst   >$([System.Text.RegularExpressions.Regex]::Match('$(_ZouFullMatch)',    '^[^;]+').Value)</_ZouFullFirst>
        <_ZouNetStdFirst >$([System.Text.RegularExpressions.Regex]::Match('$(_ZouNetStdMatch)',  '^[^;]+').Value)</_ZouNetStdFirst>

        <TargetFramework Condition="                               '$(_ZouCoreFirst)'    != ''">$(_ZouCoreFirst)</TargetFramework>
        <TargetFramework Condition="'$(TargetFramework)' == '' And '$(_ZouWindowsFirst)' != ''">$(_ZouWindowsFirst)</TargetFramework>
        <TargetFramework Condition="'$(TargetFramework)' == '' And '$(_ZouBrowserFirst)' != ''">$(_ZouBrowserFirst)</TargetFramework>
        <TargetFramework Condition="'$(TargetFramework)' == '' And '$(_ZouFullFirst)'    != ''">$(_ZouFullFirst)</TargetFramework>
        <TargetFramework Condition="'$(TargetFramework)' == '' And '$(_ZouNetStdFirst)'  != ''">$(_ZouNetStdFirst)</TargetFramework>
        
        <TargetFramework_02>$(TargetFramework)</TargetFramework_02>
        <TargetFrameworks_02>$(TargetFrameworks)</TargetFrameworks_02>
      </PropertyGroup>

      <PropertyGroup Condition="'$(TargetFramework)' != ''">
        <!-- Neutralize TargetFrameworks so that the SDK does not go into multi-targeting mode.
             Only done when a candidate actually matched; otherwise TargetFrameworks is left
             intact so ValidateTargetFramework below can report a clear error instead of the
             SDK silently falling back to normal multi-targeting on a constrained build machine. -->
        <TfmDbgInfo>$(TfmDbgInfo);1x</TfmDbgInfo>
        
        <TargetFrameworks />
      </PropertyGroup>
      
      <!-- In single targeting mode, if neither TargetFramework nor TargetFrameworks is defined, default to CoreTargetFramework -->
      <PropertyGroup Condition="'$(TargetFramework)' == '' And '$(TargetFrameworks)' == ''">
        <TfmDbgInfo>$(TfmDbgInfo);00</TfmDbgInfo>
        
        <TargetFramework>$(CoreTargetFramework)</TargetFramework>
      </PropertyGroup>
    </Otherwise>
  </Choose>

  <PropertyGroup>
    <BuildType Condition="'$(BuildType)' == '' And '$(TargetFramework)' == '' And '$(TargetFrameworks)' == ''">*Undefined*</BuildType>
    <BuildType Condition="'$(BuildType)' == '' And '$(TargetFramework)' == '' And '$(TargetFrameworks)' != ''">Multi.Outer</BuildType>
    <BuildType Condition="'$(BuildType)' == '' And '$(TargetFramework)' != '' And '$(TargetFrameworks)' != ''">Multi.Inner</BuildType>
    <BuildType Condition="'$(BuildType)' == '' And '$(TargetFramework)' != '' And '$(TargetFrameworks)' == ''">Single</BuildType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' != ''">
    <NetKind Condition="$(TargetFramework.StartsWith('netstandard', StringComparison.OrdinalIgnoreCase))">Standard</NetKind>
    <NetKind Condition="'$(NetKind)' == '' And $([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)', 1)) &lt;= 4.8">Full</NetKind>
    <NetKind Condition="'$(NetKind)' == ''">Core</NetKind>
  </PropertyGroup>

  <!--
    Guard: in single-targeting mode, if a project declared TargetFrameworks but none of the
    candidates above (CoreTargetFramework, WindowsTargetFramework, netstandard2.x) matched,
    fail fast with a clear error instead of silently falling back to multi-targeting, which
    could break later on a build machine that only has one SDK installed.
  -->
  <Target Name="ZouValidateTargetFramework" Condition="!$(MultiTargeting) And '$(TargetFramework)' == '' And '$(TargetFrameworks)' != ''" BeforeTargets="Build;Restore">
    <Error Text="$(ErrorInvalidTfmId)=($(TargetFrameworks))" Code="$(ErrorInvalidTfmIdCode)"/>
  </Target>

  <PropertyGroup>
    <TargetFrameworkOut>$(TargetFramework)</TargetFrameworkOut>
    <TargetFrameworksOut>$(TargetFrameworks)</TargetFrameworksOut>
  </PropertyGroup>

  <Import Project="LangVersions.props" Condition="'$(LangVersion)' == ''"/>

  <!--
    Warn when TargetFramework's final value (after the whole .csproj has been evaluated,
    since targets run after evaluation completes) differs from the value zou itself resolved
    (TargetFrameworkOut). This happens when a project sets <TargetFramework> directly in its
    .csproj, which silently overrides zou's resolution — bypassing -p:ZouTargetFramework,
    MultiTargeting, and the ZouValidateTargetFramework guard for that project, with no other
    feedback. Legitimate fixed-TFM projects (e.g. a legacy tool pinned to net4.8) should set
    that default in the project's own zou.build.tfm.props instead (TargetFramework
    Condition="'$(TargetFramework)' == ''" ...), which keeps zou's resolution in the loop; set
    ZouAllowLegacyTfmOverride=true there to silence this warning where the override in
    the .csproj itself is intentional and known.
  -->
  <Target Name="ZouWarnTfmOverride"
          Condition="'$(TargetFramework)' != '$(TargetFrameworkOut)' And '$(ZouAllowLegacyTfmOverride)' != 'true'"
          BeforeTargets="Build;Restore">
    <Warning Text="'$(MSBuildProjectFile)': TargetFramework was overridden to '$(TargetFramework)' after zou's own resolution ('$(TargetFrameworkOut)'), most likely by a &lt;TargetFramework&gt; set directly in the .csproj. This silently bypasses -p:ZouTargetFramework, MultiTargeting, and ZouValidateTargetFramework for this project. If intentional, set ZouAllowLegacyTfmOverride=true in this project's zou.build.tfm.props to suppress this warning."
             Code="$(WarnTfmOverrideIdCode)" />
  </Target>

  <Target Name="TraceTargetFrameworkBuildProps" Condition="'$(TfmDebug)' == 'true'" BeforeTargets="ZouValidateTargetFramework;ZouWarnTfmOverride">
    <Message Importance="high" Text="$(NC) " />
    <Message Importance="high" Text="$(T0)$([MSBuild]::MakeRelative('$(BundleDir)', '$(MSBuildThisFileFullPath)')) ($(BundleRelativeProjectPath))$(NC)" />

    <PropertyGroup>
      <TfmMultiColor Condition="'$(BuildType)'        == 'Multi.Outer'">$(Brown)</TfmMultiColor>
      <TfmMultiColor Condition="'$(TfmMultiColor)'    == ''">$(NC)</TfmMultiColor>

      <TfmEndColor   Condition="'$(TargetFramework)'  != '$(TargetFrameworkOut)'" >$(Brown)</TfmEndColor>
      <TfmsEndColor  Condition="'$(TargetFrameworks)' != '$(TargetFrameworksOut)'">$(Brown)</TfmsEndColor>
      <TfmColor      Condition="'$(TargetFramework)'  != '$(TargetFrameworkOut)'" >$(Yellow)</TfmColor>
      <TfmsColor     Condition="'$(TargetFrameworks)' != '$(TargetFrameworksOut)'">$(Yellow)</TfmsColor>

      <TfmEndColor   Condition="'$(TfmEndColor)'      == ''">$(Green)</TfmEndColor>
      <TfmsEndColor  Condition="'$(TfmsEndColor)'     == ''">$(Green)</TfmsEndColor>
      <TfmColor      Condition="'$(TfmColor)'         == ''">$(LightGreen)</TfmColor>
      <TfmsColor     Condition="'$(TfmsColor)'        == ''">$(LightGreen)</TfmsColor>
    </PropertyGroup>

    <Message Importance="high" Text="$(TfmMultiColor)MaxCpuCount            = $(Purple)$(MaxCpuCount)$(NC)"                 Condition="'$(MaxCpuCount)' != ''" />
    <Message Importance="high" Text="$(TfmMultiColor)ZouAgentType           = $(Purple)$(ZouAgentType)$(NC)"                Condition="'$(ZouAgentType)' != ''" />
    <Message Importance="high" Text="$(TfmMultiColor)TfmDbgInfo             = $(Purple)$(TfmDbgInfo)$(NC)"                  Condition="'$(TfmDbgInfo)' != ''" />
    <Message Importance="high" Text="$(TfmMultiColor)MultiTargeting         = $(Yellow)$(MultiTargeting)$(NC)" />           
    <Message Importance="high" Text="$(TfmMultiColor)BuildType              = $(BuildType)$(NC)" />                         
    <Message Importance="high" Text="$(TfmMultiColor)NetKind                = $(NetKind)$(NC)"                              Condition="'$(TargetFramework)'  != ''" />

    <Message Importance="high" Text="$(TfmMultiColor)ZouTargetFrameworks    = $(Yellow)($(ZouTargetFrameworks))$(NC)"       Condition="'$(ZouTargetFrameworks)' != ''" />
    <Message Importance="high" Text="$(TfmMultiColor)ZouTargetFrameworksInp = $(Yellow)($(ZouTargetFrameworksInp))$(NC)"    Condition="'$(ZouTargetFrameworksInp)'  != ''" />
    <Message Importance="high" Text="$(TfmMultiColor)TargetFrameworksInp    = $(LightBlue)($(TargetFrameworksInp))$(NC)"    Condition="'$(TargetFrameworksInp)' != ''" />
    <Message Importance="high" Text="$(TfmMultiColor)TargetFrameworks_01    = $(LightBlue)($(TargetFrameworks_01))$(NC)"    Condition="'$(TargetFrameworks_01)'  != ''" />
    <Message Importance="high" Text="$(TfmMultiColor)TargetFrameworks_02    = $(LightBlue)($(TargetFrameworks_02))$(NC)"    Condition="'$(TargetFrameworks_02)'  != ''" />

    <Message Importance="high" Text="$(TfmMultiColor)ZouTargetFramework     = $(Yellow)$(ZouTargetFramework)$(NC)"          Condition="'$(ZouTargetFramework)'  != ''" />
    <Message Importance="high" Text="$(TfmMultiColor)ZouTargetFrameworkInp  = $(Yellow)$(ZouTargetFrameworkInp)$(NC)"       Condition="'$(ZouTargetFrameworkInp)'  != ''" />
    <Message Importance="high" Text="$(TfmMultiColor)TargetFrameworkInp     = $(LightBlue)$(TargetFrameworkInp)$(NC)"       Condition="'$(TargetFrameworkInp)'  != ''" />
    <Message Importance="high" Text="$(TfmMultiColor)TargetFramework_01     = $(LightBlue)$(TargetFramework_01)$(NC)"       Condition="'$(TargetFramework_01)'  != ''" />
    <Message Importance="high" Text="$(TfmMultiColor)TargetFramework_02     = $(LightBlue)$(TargetFramework_02)$(NC)"       Condition="'$(TargetFramework_02)'  != ''" />

    <Message Importance="high" Text="$(TfmMultiColor)LangVersion            = $(Green)C#$(LangVersion)$(NC)"                Condition="'$(BuildType)' != 'Multi.Outer'" />
    <Message Importance="high" Text="$(TfmMultiColor)TargetFrameworksOut    = $(TfmsEndColor)($(TargetFrameworksOut))$(NC)" Condition="'$(TargetFrameworksOut)' != ''" />
    <Message Importance="high" Text="$(TfmMultiColor)TargetFrameworks       = $(TfmsColor)($(TargetFrameworks))$(NC)"       Condition="'$(TargetFrameworks)' != ''" />
    <Message Importance="high" Text="$(TfmMultiColor)TargetFrameworkOut     = $(TfmEndColor)$(TargetFrameworkOut)$(NC)"     Condition="'$(TargetFrameworkOut)'  != ''" />
    <Message Importance="high" Text="$(TfmMultiColor)TargetFramework        = $(TfmColor)$(TargetFramework)$(NC)"           Condition="'$(TargetFramework)'  != ''" />
  </Target>

</Project>
