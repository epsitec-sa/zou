<Project InitialTargets="TraceTargetFrameworkProps">

  <PropertyGroup>
    <TargetFrameworkImported>true</TargetFrameworkImported>
  </PropertyGroup>

  <!--
  CoreTargetFramework backward compatibility:
  When CoreTargetFramework is specified, either on the CLI or in the root Directory.Build.props
  we will use it as the BareTargetFramework, which is the new property name for the target framework control.
  -->
  <PropertyGroup Condition="'$(CoreTargetFramework)' != '' And '$(BareTargetFramework)' == '' And '$(MultiTargeting)' != 'true'">
    <BareTargetFramework>$(CoreTargetFramework)</BareTargetFramework>
  </PropertyGroup>
  
  <PropertyGroup Condition="'$(BareTargetFramework)' != ''">
    <_ZouTfmVer>$([MSBuild]::GetTargetFrameworkVersion('$(BareTargetFramework)', 1))</_ZouTfmVer>
    <_ZouTfmFull Condition="'$(_ZouTfmVer)' &lt;= '4.8'">true</_ZouTfmFull>
    <_ZouTfmFull Condition="'$(_ZouTfmFull)' == ''">false</_ZouTfmFull>
    <CoreTargetFramework Condition="'$(_ZouTfmFull)' != 'true'">$(BareTargetFramework)</CoreTargetFramework>
    <FullTargetFramework Condition="'$(_ZouTfmFull)' == 'true'">$(BareTargetFramework)</FullTargetFramework>
  </PropertyGroup>

  <!-- Keep framework lists in ascending version order; UseLatestTfm selects an endpoint during build resolution. -->
  <PropertyGroup>
    <CoreTargetFramework     Condition="'$(CoreTargetFramework)'     == ''">net8.0</CoreTargetFramework>
    <CoreTargetFrameworks    Condition="'$(CoreTargetFrameworks)'    == ''">net8.0;net10.0</CoreTargetFrameworks>
    <WindowsTargetFrameworks Condition="'$(WindowsTargetFrameworks)' == ''">net8.0-windows;net10.0-windows</WindowsTargetFrameworks>
    <BrowserTargetFrameworks Condition="'$(BrowserTargetFrameworks)' == ''">net8.0-browser;net10.0-browser</BrowserTargetFrameworks>
    <NetStdTargetFrameworks  Condition="'$(NetStdTargetFrameworks)'  == ''">netstandard2.0;netstandard2.1</NetStdTargetFrameworks>
    
    <FullTargetFramework     Condition="'$(FullTargetFramework)'     == ''">net4.8</FullTargetFramework>
    <WineTargetFramework     Condition="'$(WineTargetFramework)'     == ''">netcoreapp3.1</WineTargetFramework>
    <WindowsTargetFramework  Condition="'$(WindowsTargetFramework)'  == ''">$(CoreTargetFramework)-windows</WindowsTargetFramework>
    <BrowserTargetFramework  Condition="'$(BrowserTargetFramework)'  == ''">$(CoreTargetFramework)-browser</BrowserTargetFramework>
  </PropertyGroup>

  <Target Name="TraceTargetFrameworkProps" Condition="'$(TfmDefDebug)' == 'true'">
    <Message Importance="high" Text="$(T0)$([MSBuild]::MakeRelative('$(BundleDir)', '$(MSBuildThisFileFullPath)')) ($(BundleRelativeProjectPath))$(NC)" />

    <Message Importance="high" Text="_ZouTfmVer              = $(_ZouTfmVer)" />
    <Message Importance="high" Text="_ZouTfmFull             = $(_ZouTfmFull)" />
    <Message Importance="high" Text="BareTargetFramework     = $(BareTargetFramework)" />
    <Message Importance="high" Text="CoreTargetFramework     = $(CoreTargetFramework)" />
    <Message Importance="high" Text="FullTargetFramework     = $(FullTargetFramework)" />
    <Message Importance="high" Text="WindowsTargetFramework  = $(WindowsTargetFramework)" />
    <Message Importance="high" Text="BareTargetFrameworks    = $(BareTargetFrameworks)" />
    <Message Importance="high" Text="CoreTargetFrameworks    = $(CoreTargetFrameworks)" />
    <Message Importance="high" Text="WindowsTargetFrameworks = $(WindowsTargetFrameworks)" />
    <Message Importance="high" Text="BrowserTargetFrameworks = $(BrowserTargetFrameworks)" />
    <Message Importance="high" Text="NetStdTargetFrameworks  = $(NetStdTargetFrameworks)" />
    <Message Importance="high" Text=" " />
  </Target>
</Project>
