<Project InitialTargets="TraceTargetFrameworkProps;ZouValidateCoreTargetFrameworkMin">

  <PropertyGroup>
    <TargetFrameworkImported>true</TargetFrameworkImported>
  </PropertyGroup>

  <!--
  CoreTargetFramework backward compatibility:
  When CoreTargetFramework is specified, either on the CLI or in the root Directory.Build.props
  we will use it as the BareTargetFramework, which is the new property name for the target framework control.
  -->
  <PropertyGroup Condition="'$(CoreTargetFramework)' != '' And '$(BareTargetFramework)' == '' And '$(MultiTargeting)' != 'true'">
    <BareTargetFramework>$(CoreTargetFramework)</BareTargetFramework>
  </PropertyGroup>
  
  <PropertyGroup Condition="'$(BareTargetFramework)' != ''">
    <_ZouTfmVer>$([MSBuild]::GetTargetFrameworkVersion('$(BareTargetFramework)', 1))</_ZouTfmVer>
    <_ZouTfmFull Condition="'$(_ZouTfmVer)' &lt;= '4.8'">true</_ZouTfmFull>
    <_ZouTfmFull Condition="'$(_ZouTfmFull)' == ''">false</_ZouTfmFull>
    <CoreTargetFramework Condition="'$(_ZouTfmFull)' != 'true'">$(BareTargetFramework)</CoreTargetFramework>
    <FullTargetFramework Condition="'$(_ZouTfmFull)' == 'true'">$(BareTargetFramework)</FullTargetFramework>
  </PropertyGroup>

  <!-- Keep framework lists in ascending version order; UseLatestTfm selects an endpoint during build resolution. -->
  <PropertyGroup>
    <CoreTargetFramework     Condition="'$(CoreTargetFramework)'     == ''">net8.0</CoreTargetFramework>
    <CoreTargetFrameworks    Condition="'$(CoreTargetFrameworks)'    == ''">net8.0;net10.0</CoreTargetFrameworks>
    <WindowsTargetFrameworks Condition="'$(WindowsTargetFrameworks)' == ''">net8.0-windows;net10.0-windows</WindowsTargetFrameworks>
    <BrowserTargetFrameworks Condition="'$(BrowserTargetFrameworks)' == ''">net8.0-browser;net10.0-browser</BrowserTargetFrameworks>
    <NetStdTargetFrameworks  Condition="'$(NetStdTargetFrameworks)'  == ''">netstandard2.0;netstandard2.1</NetStdTargetFrameworks>
    
    <FullTargetFramework     Condition="'$(FullTargetFramework)'     == ''">net4.8</FullTargetFramework>
    <WineTargetFramework     Condition="'$(WineTargetFramework)'     == ''">netcoreapp3.1</WineTargetFramework>
    <WindowsTargetFramework  Condition="'$(WindowsTargetFramework)'  == ''">$(CoreTargetFramework)-windows</WindowsTargetFramework>
    <BrowserTargetFramework  Condition="'$(BrowserTargetFramework)'  == ''">$(CoreTargetFramework)-browser</BrowserTargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <Net11Available Condition="$(NETCoreSdkVersion.StartsWith('11.'))">true</Net11Available>
  </PropertyGroup>

  <!-- MSBuild/Visual Studio: the running SDK is not necessarily the newest installed one, so look for an installed 11.0.* SDK folder. -->
  <PropertyGroup Condition="'$(Net11Available)' != 'true'">
    <_ZouDotNetRoot Condition="'$(DOTNET_ROOT)' != '' And Exists('$(DOTNET_ROOT)\sdk')">$(DOTNET_ROOT)</_ZouDotNetRoot>
    <_ZouDotNetRoot Condition="'$(_ZouDotNetRoot)' == ''">$(ProgramW6432)\dotnet</_ZouDotNetRoot>
    <_ZouDotNetRoot Condition="'$(_ZouDotNetRoot)' == '' Or !Exists('$(_ZouDotNetRoot)\sdk')">$(ProgramFiles)\dotnet</_ZouDotNetRoot>
    <Net11Available Condition="Exists('$(_ZouDotNetRoot)\sdk') And $([System.IO.Directory]::GetDirectories('$(_ZouDotNetRoot)\sdk', '11.0.*').Length) &gt; 0">true</Net11Available>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Net11Available)' == 'true'">
    <CoreTargetFrameworks   >$(CoreTargetFrameworks);net11.0</CoreTargetFrameworks>
    <WindowsTargetFrameworks>$(WindowsTargetFrameworks);net11.0-windows</WindowsTargetFrameworks>
    <BrowserTargetFrameworks>$(BrowserTargetFrameworks);net11.0-browser</BrowserTargetFrameworks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CoreTargetFrameworkMin)' != ''">
    <_ZouCoreTargetFrameworkMinVersion>$([MSBuild]::GetTargetFrameworkVersion('$(CoreTargetFrameworkMin)', 1))</_ZouCoreTargetFrameworkMinVersion>
  </PropertyGroup>

  <!-- Property lists are evaluated before MSBuild items, so filter the framework versions defined above directly. -->
  <PropertyGroup Condition="'$(CoreTargetFrameworkMin)' != '' And $([MSBuild]::GetTargetFrameworkVersion('net8.0', 1)) &lt; $(_ZouCoreTargetFrameworkMinVersion)">
    <CoreTargetFrameworks>$([MSBuild]::Unescape($([System.Text.RegularExpressions.Regex]::Replace('$(CoreTargetFrameworks)', '(^|;)net8\.0(;|$)', '$1').Trim(';'))))</CoreTargetFrameworks>
    <WindowsTargetFrameworks>$([MSBuild]::Unescape($([System.Text.RegularExpressions.Regex]::Replace('$(WindowsTargetFrameworks)', '(^|;)net8\.0-windows(;|$)', '$1').Trim(';'))))</WindowsTargetFrameworks>
    <BrowserTargetFrameworks>$([MSBuild]::Unescape($([System.Text.RegularExpressions.Regex]::Replace('$(BrowserTargetFrameworks)', '(^|;)net8\.0-browser(;|$)', '$1').Trim(';'))))</BrowserTargetFrameworks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CoreTargetFrameworkMin)' != '' And $([MSBuild]::GetTargetFrameworkVersion('net10.0', 1)) &lt; $(_ZouCoreTargetFrameworkMinVersion)">
    <CoreTargetFrameworks>$([MSBuild]::Unescape($([System.Text.RegularExpressions.Regex]::Replace('$(CoreTargetFrameworks)', '(^|;)net10\.0(;|$)', '$1').Trim(';'))))</CoreTargetFrameworks>
    <WindowsTargetFrameworks>$([MSBuild]::Unescape($([System.Text.RegularExpressions.Regex]::Replace('$(WindowsTargetFrameworks)', '(^|;)net10\.0-windows(;|$)', '$1').Trim(';'))))</WindowsTargetFrameworks>
    <BrowserTargetFrameworks>$([MSBuild]::Unescape($([System.Text.RegularExpressions.Regex]::Replace('$(BrowserTargetFrameworks)', '(^|;)net10\.0-browser(;|$)', '$1').Trim(';'))))</BrowserTargetFrameworks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CoreTargetFrameworkMin)' != '' And $([MSBuild]::GetTargetFrameworkVersion('net11.0', 1)) &lt; $(_ZouCoreTargetFrameworkMinVersion)">
    <CoreTargetFrameworks>$([MSBuild]::Unescape($([System.Text.RegularExpressions.Regex]::Replace('$(CoreTargetFrameworks)', '(^|;)net11\.0(;|$)', '$1').Trim(';'))))</CoreTargetFrameworks>
    <WindowsTargetFrameworks>$([MSBuild]::Unescape($([System.Text.RegularExpressions.Regex]::Replace('$(WindowsTargetFrameworks)', '(^|;)net11\.0-windows(;|$)', '$1').Trim(';'))))</WindowsTargetFrameworks>
    <BrowserTargetFrameworks>$([MSBuild]::Unescape($([System.Text.RegularExpressions.Regex]::Replace('$(BrowserTargetFrameworks)', '(^|;)net11\.0-browser(;|$)', '$1').Trim(';'))))</BrowserTargetFrameworks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CoreTargetFrameworkMin)' != ''">
    <_ZouFirstCoreTargetFramework>$([System.Text.RegularExpressions.Regex]::Replace('$(CoreTargetFrameworks)', '^([^;]+)(;.*)?$', '$1'))</_ZouFirstCoreTargetFramework>
    <_ZouFirstWindowsTargetFramework>$([System.Text.RegularExpressions.Regex]::Replace('$(WindowsTargetFrameworks)', '^([^;]+)(;.*)?$', '$1'))</_ZouFirstWindowsTargetFramework>
    <_ZouFirstBrowserTargetFramework>$([System.Text.RegularExpressions.Regex]::Replace('$(BrowserTargetFrameworks)', '^([^;]+)(;.*)?$', '$1'))</_ZouFirstBrowserTargetFramework>
    <CoreTargetFramework Condition="'$(CoreTargetFramework)' != '' And $([MSBuild]::GetTargetFrameworkVersion('$(CoreTargetFramework)', 1)) &lt; $(_ZouCoreTargetFrameworkMinVersion)">$(_ZouFirstCoreTargetFramework)</CoreTargetFramework>
    <WindowsTargetFramework Condition="'$(WindowsTargetFramework)' != '' And $([MSBuild]::GetTargetFrameworkVersion('$(WindowsTargetFramework)', 1)) &lt; $(_ZouCoreTargetFrameworkMinVersion)">$(_ZouFirstWindowsTargetFramework)</WindowsTargetFramework>
    <BrowserTargetFramework Condition="'$(BrowserTargetFramework)' != '' And $([MSBuild]::GetTargetFrameworkVersion('$(BrowserTargetFramework)', 1)) &lt; $(_ZouCoreTargetFrameworkMinVersion)">$(_ZouFirstBrowserTargetFramework)</BrowserTargetFramework>
  </PropertyGroup>

  <!-- CoreTargetFrameworkMin must be a bare modern TFM (net5.0 or later) and must leave at least one Core framework. -->
  <Target Name="ZouValidateCoreTargetFrameworkMin" Condition="'$(CoreTargetFrameworkMin)' != ''">
    <PropertyGroup>
      <_ZouTfmMinValid>$([System.Text.RegularExpressions.Regex]::IsMatch('$(CoreTargetFrameworkMin)', '^net[0-9]+\.[0-9]+$'))</_ZouTfmMinValid>
      <_ZouTfmMinValid Condition="'$(_ZouTfmMinValid)' == 'True' And $([MSBuild]::VersionLessThan('$(_ZouCoreTargetFrameworkMinVersion)', '5.0'))">False</_ZouTfmMinValid>
    </PropertyGroup>
    <Error Condition="'$(_ZouTfmMinValid)' != 'True'" Code="$(ErrorInvalidTfmMinCode)" Text="$(ErrorInvalidTfmMin)" />
    <Error Condition="'$(_ZouTfmMinValid)' == 'True' And '$(CoreTargetFrameworks)' == ''" Code="$(ErrorNoTfmAboveMinCode)" Text="$(ErrorNoTfmAboveMin)" />
  </Target>

  <Target Name="TraceTargetFrameworkProps" Condition="'$(TfmDefDebug)' == 'true'">
    <Message Importance="high" Text=" " />
    <Message Importance="high" Text="$(T0)$([MSBuild]::MakeRelative('$(BundleDir)', '$(MSBuildThisFileFullPath)')) ($(BundleRelativeProjectPath))$(NC)" />

    <Message Importance="high" Text="NETCoreSdkVersion       = $(NETCoreSdkVersion)" />
    <Message Importance="high" Text="Net11Available          = $(Net11Available)" />
    <Message Importance="high" Text="CoreTargetFrameworkMin  = $(CoreTargetFrameworkMin)" Condition="'$(CoreTargetFrameworkMin)' != ''" />
    <Message Importance="high" Text="_ZouDotNetRoot          = $(_ZouDotNetRoot)"         Condition="'$(_ZouDotNetRoot)' != ''" />
    <Message Importance="high" Text="_ZouTfmVer              = $(_ZouTfmVer)"             Condition="'$(_ZouTfmVer)' != ''" />
    <Message Importance="high" Text="_ZouTfmFull             = $(_ZouTfmFull)"            Condition="'$(_ZouTfmFull)' != ''" />
    <Message Importance="high" Text="BareTargetFramework     = $(BareTargetFramework)"    Condition="'$(BareTargetFramework)' != ''" />
    <Message Importance="high" Text="CoreTargetFramework     = $(CoreTargetFramework)" />
    <Message Importance="high" Text="FullTargetFramework     = $(FullTargetFramework)" />
    <Message Importance="high" Text="WindowsTargetFramework  = $(WindowsTargetFramework)" />
    <Message Importance="high" Text="BrowserTargetFramework  = $(BrowserTargetFramework)" />
    <Message Importance="high" Text="BareTargetFrameworks    = $(BareTargetFrameworks)"   Condition="'$(BareTargetFrameworks)' != ''" />
    <Message Importance="high" Text="CoreTargetFrameworks    = $(CoreTargetFrameworks)" />
    <Message Importance="high" Text="WindowsTargetFrameworks = $(WindowsTargetFrameworks)" />
    <Message Importance="high" Text="BrowserTargetFrameworks = $(BrowserTargetFrameworks)" />
    <Message Importance="high" Text="NetStdTargetFrameworks  = $(NetStdTargetFrameworks)" />
  </Target>
</Project>
