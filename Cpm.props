<!--
  This file is used to compute TFM information for the CPM database and the pruning of package references.
  
  CpmTFM   ::= (net4.8|net8.0|net10.0|net11.0 ...)
  CpmVer   ::= (4.8|8.0|10.0|11.0 ...)
  CpmVerId ::= (4|8|10|11 ...)
  CpmId    ::= (Floating|net4|net8|net10|net11 ...)
  CpmFull  ::= true if CpmVer <= 4.8, false otherwise
  -->
<Project>

  <PropertyGroup>
    <CpmPropsImported>true</CpmPropsImported>
  </PropertyGroup>
  
  <PropertyGroup Condition="'$(TargetFramework)' != ''">
    <CpmTFM>$(TargetFramework)</CpmTFM>
    <CpmTFM Condition="$(TargetFramework.StartsWith('netstandard', StringComparison.OrdinalIgnoreCase))">$(CoreTargetFramework)</CpmTFM>

    <CpmVer>$([MSBuild]::GetTargetFrameworkVersion('$(CpmTFM)', 1))</CpmVer>
    <CpmFull Condition="'$(CpmVer)' &lt;= '4.8'">true</CpmFull>
    <CpmFull Condition="'$(CpmFull)' == ''">false</CpmFull>

    <CpmVerId>$(CpmVer)</CpmVerId>
    <CpmVerId Condition="$(CpmFull)">$(CpmVer.Substring(0, 1))</CpmVerId>
    <CpmId Condition="'$(CpmId)'== ''">net$(CpmVerId)</CpmId>
  </PropertyGroup>

  <Target Name="TraceCpm" BeforeTargets="CollectPackageReferences" Condition="'$(CpmTFM)' != '' And '$(CpmDebug)' != ''">
    <Message Importance="high" Text="$(T0)$([MSBuild]::MakeRelative('$(BundleDir)', '$(MSBuildThisFileFullPath)')) ($(BundleRelativeProjectPath))$(NC)" />

    <Message Importance="high" Text="CpmFull  = $(CpmFull)" />
    <Message Importance="high" Text="CpmTFM   = $(CpmTFM)" />
    <Message Importance="high" Text="CpmVer   = $(CpmVer)" />
    <Message Importance="high" Text="CpmVerId = $(CpmVerId)" />
    <Message Importance="high" Text="CpmId    = $(CpmId)" />
    <Message Importance="high" Text=" " />
  </Target>

</Project>
